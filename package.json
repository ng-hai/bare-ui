{
  "name": "ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "registry:validate": "shadcn build --output node_modules/.cache/ui-registry",
    "gen:theme": "tsx registry/theme/gen-theme.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@radix-ui/colors": "3.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "bezier-easing": "3.0.1",
    "colorjs.io": "0.7.1",
    "jsdom": "30.0.1",
    "shadcn": "4.19.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
